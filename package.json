{
  "name": "lefleat",
  "version": "1.0.0",
  "description": "Мапа Львова на Leaflet",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 8090",
    "preview": "vite preview --port 8090",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "check-rules": "npm run lint && npm run format --check",
    "serve": "python3 -m http.server 8090 --directory dist"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-distortableimage": "^0.20.7",
    "leaflet-draw": "^1.0.4",
    "leaflet-omnivore": "^0.3.4",
    "leaflet-toolbar": "^0.4.0-alpha.2",
    "leaflet.polylinemeasure": "^3.0.0",
    "sortablejs": "^1.15.0",
    "typescript": "^5.8.3"
  }
}
